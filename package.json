{
  "name": "@soffits/dsh-points",
  "version": "0.1.1",
  "description": "Spend earned points inside DeepSeek Harness: any plugin can price an extra, and at the moment of the action the person sees the price and their balance in one dialog and buys it there, through the points ledger they already keep.",
  "type": "module",
  "license": "MIT",
  "author": "Sakina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-points.git"
  },
  "homepage": "https://github.com/soffits/dsh-points#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-points/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "points",
    "rewards",
    "adhd"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && for f in index.js client.js src/*.js src/client/*.js test/*.js test/fixtures/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
